# Copy to .env and replace the token with a private random value.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JASSIM_API_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Exact HTTPS origin of the dashboard, or empty if unused.
JASSIM_CORS_ORIGIN=
# Use qwen3.5:9b on a GPU host with enough memory for stronger answers; 4b is the lighter fallback.
JASSIM_OLLAMA_MODEL=qwen3.5:4b
JASSIM_OLLAMA_KEEP_ALIVE=-1
JASSIM_NUM_CTX=8192
JASSIM_NUM_PREDICT=3072
JASSIM_REQUEST_TIMEOUT=300
JASSIM_MAX_CONCURRENT=1
JASSIM_QUEUE_TIMEOUT=180
JASSIM_HISTORY_MESSAGES=20
JASSIM_HISTORY_CHAR_BUDGET=32000
JASSIM_PORT=8787

# Adaptive multi-provider evaluation. Synthetic test prompts only.
JASSIM_ENABLE_PUBLIC_PROVIDERS=true
# Privacy guard: real user messages stay on the private Ollama server unless explicitly enabled.
JASSIM_ALLOW_EXTERNAL_CHAT=false
JASSIM_PROVIDER_TIMEOUT=45
